# Large local datasets (not for GitHub): rebuilt by OBDsaveSourceData.py; see data/README.md
/data/*
!/data/README.md
/html/*
!/html/.gitkeep
/html_old/
/plots/*
!/plots/.gitkeep
/plots_old/
# Run logs written by OBDsaveSourceData.py on every rebuild (timings and counts per n).
# The 26 logs committed before 2026-10-07 stay tracked; new ones stay local.
/log/*.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
